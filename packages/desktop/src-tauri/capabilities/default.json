{
  "identifier": "default",
  "description": "Default capabilities for PanelShelf desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:default",
      "allow": [
        {
          "name": "binaries/panelshelf-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
