{
  "name": "@panelshelf/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.57.5",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "mime-types": "^2.1.35",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rss-parser": "^3.13.0",
    "undici": "^7.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
