# ── PanelShelf Configuration ────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# All variables are optional — defaults are shown below.

# Server
# PORT=3001
# HOST=0.0.0.0

# Data directories
# DATA_DIR=./data
# DOWNLOAD_DIR=./data/downloads

# Downloads
# MAX_CONCURRENT_DOWNLOADS=3

# Source refresh
# DEFAULT_REFRESH_INTERVAL_MIN=60

# Library
# AUTO_SCAN_ON_START=false

# Logging
# LOG_LEVEL=info

# Cloudflare bypass — curl_cffi sidecar (TLS fingerprint impersonation)
# Requires the curl-cffi-sidecar service to be running
# CURL_CFFI_URL=http://localhost:8192/fetch

# Cloudflare bypass — FlareSolverr (full browser proxy, optional)
# Requires FlareSolverr to be running
# FLARESOLVERR_URL=http://localhost:8191/v1
